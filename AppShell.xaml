<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:MauiNet11Preview3Sample.Pages"
       x:Class="MauiNet11Preview3Sample.AppShell"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="#999999">

    <TabBar>
        <Tab x:Name="Preview4Tab"
             Title="P4 New"
             Icon="tab_bell.png"
             BadgeText="4"
             BadgeColor="#D600AA"
             BadgeTextColor="White">
            <ShellContent x:Name="Preview4ShellContent"
                          ContentTemplate="{DataTemplate pages:Preview4Page}" />
        </Tab>

        <ShellContent Title="P3 Maps"
                      Icon="tab_maps.png"
                      ContentTemplate="{DataTemplate pages:MapsPage}" />

        <ShellContent Title="P3 Press"
                      Icon="tab_longpress.png"
                      ContentTemplate="{DataTemplate pages:LongPressPage}" />

        <ShellContent Title="P3 XAML"
                      Icon="tab_code.png"
                      ContentTemplate="{DataTemplate pages:XamlPage}" />
    </TabBar>

</Shell>
